# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# ACLED_USERNAME / ACLED_PASSWORD
#   Required. ACLED is the primary Nigerian outcome source. Registration is
#   free and self-service at https://acleddata.com/register
#   Authentication is OAuth2 password grant; the token is cached on disk and
#   refreshed automatically.
ACLED_USERNAME=
ACLED_PASSWORD=

# UCDP_API_TOKEN
#   Optional. UCDP is a secondary outcome source used for the coverage
#   comparison, and its bulk CSV route needs no credential. Request a token by
#   emailing mertcan.yilmaz@pcr.uu.se if you prefer the API route.
UCDP_API_TOKEN=

# CENSUS_API_KEY
#   Optional but recommended for ACS. Free and instant at
#   https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
