# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# UCDP_API_TOKEN
#   Required. The UCDP API is free but token-authenticated since access
#   control was introduced to protect service stability. Request one by
#   emailing mertcan.yilmaz@pcr.uu.se with your name, affiliation, role and a
#   brief description of the project. Responses take 3 to 5 working days.
#   Quota is 5,000 requests per day, errors included.
UCDP_API_TOKEN=

# CENSUS_API_KEY
#   Optional but recommended for ACS. Free and issued instantly at
#   https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
